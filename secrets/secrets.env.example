# secrets/secrets.env.example — template for ~/.secrets.env
#
# Copy to ~/.secrets.env, fill in the real values, chmod 600. setup.sh does
# the copy and the chmod if the file does not exist yet.
#
# shell/env.sh sources it, so the tokens reach SLURM jobs and `ssh host cmd`
# as well as interactive shells. Plain `export` lines only: it is read by bash
# and by zsh, so no zsh-isms.
#
# Environment variables only. Credentials that are *files* — .git-credentials,
# rclone.conf, ssh keys — are carried by secrets.sh alongside this one;
# they do not belong here.

# --- common ----------------------------------------------------------------
export OPENAI_API_KEY=""
export HF_TOKEN=""            # also what the `hf` CLI reads; no login needed


# A GitHub token. With it set, `gh` is signed in on every machine without
# `gh auth login`, and tools/cli.sh uses it for the GitHub API, whose
# anonymous limit is shared by everyone on a cluster login node. Prefer a
# fine-grained token limited to the repositories and permissions you need:
# every program you run, a coding agent included, can read this variable.
export GITHUB_TOKEN=""

# --- add when you need them ------------------------------------------------
# Commented out rather than left empty: some SDKs treat a variable that is set
# but empty as configured and then fail with an authentication error.
#
# Claude Code and Codex sign in with their own OAuth (`claude`, `codex login`)
# and do not read this. It is only for calling the API from your own code —
# and if it is set while you run `claude`, it bills the API account rather
# than the subscription.
# export ANTHROPIC_API_KEY=""

# $WANDB_DIR is already pointed at scratch by shell/env.sh; this is what saves
# you the `wandb login` on every new machine.
# export WANDB_API_KEY=""

# Other model providers, by the names their own SDKs read:
# export DEEPSEEK_API_KEY=""
# export MOONSHOT_API_KEY=""     # Kimi; OpenAI-compatible at api.moonshot.ai/v1
