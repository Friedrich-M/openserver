# shell/zshrc — what interactive zsh gets from the bundle, sourced from your
# ~/.zshrc.
#
# Not copied over ~/.zshrc: setup.sh adds a marked block at the end of the
# ~/.zshrc you have (or makes one holding only the block), and the block
# sources this file. When your own lines above it already load oh-my-zsh or
# powerlevel10k, this file leaves the prompt, plugins, history and shell
# options to them and adds the environment, modules, aliases, functions and
# SLURM helpers. Anything machine-specific belongs in hosts/<host>.sh
# (synced), your ~/.zshrc or ~/.zshrc.local (not synced) — never here.
#
# Load order matters in three places:
#   1. The Powerlevel10k instant prompt must come first in ~/.zshrc: on its
#      own (a ~/.zshrc that is only the block) this file starts with it.
#   2. shell/env.sh runs before modules, so $SCRATCH and PATH exist first.
#   3. ~/.zshrc.local runs last, so it can override anything above it.


# ---------------------------------------------------------------------------
# Your own setup
# ---------------------------------------------------------------------------
# oh-my-zsh defines `omz`, powerlevel10k `p10k`: either means the lines of
# ~/.zshrc above the block set up the prompt and plugins already, and loading
# them again would double every hook and slow every prompt.
typeset -gi _srv_own_setup=0
# Likewise the other frameworks and prompts: prezto (pmodload), zinit,
# antidote, zim (zimfw), starship and pure.
(( ${+functions[omz]} || ${+functions[p10k]} || ${+functions[pmodload]} ||
   ${+functions[zinit]} || ${+functions[antidote]} || ${+functions[zimfw]} ||
   ${+functions[starship_precmd]} || ${+functions[prompt_pure_setup]} )) && _srv_own_setup=1


# ---------------------------------------------------------------------------
# Powerlevel10k instant prompt (keep first)
# ---------------------------------------------------------------------------
if (( ! _srv_own_setup )) &&
   [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi


# ---------------------------------------------------------------------------
# Where the bundle lives
# ---------------------------------------------------------------------------
# Set before anything else that refers to it. shell/env.sh is sourced further
# down, once oh-my-zsh has had its say about $PATH.
export SRV_DIR="${SRV_DIR:-$HOME/server}"


# ---------------------------------------------------------------------------
# Oh My Zsh
# ---------------------------------------------------------------------------
if (( ! _srv_own_setup )); then
  export ZSH="$HOME/.oh-my-zsh"

  # Skip compinit's insecure-directory prompt; on shared filesystems it flags
  # group-writable module directories and can hang a non-interactive zsh.
  export ZSH_DISABLE_COMPFIX=true

  # One compdump per host+version: $HOME is shared between clusters, and a dump
  # built elsewhere produces broken completions.
  ZSH_COMPDUMP="$HOME/.cache/zsh/zcompdump-${HOST%%.*}-${ZSH_VERSION}"
  [[ -d ${ZSH_COMPDUMP:h} ]] || mkdir -p ${ZSH_COMPDUMP:h}

  ZSH_THEME="powerlevel10k/powerlevel10k"

  plugins=(
    git
    z
    extract
    sudo
    colored-man-pages
    command-not-found
    zsh-autosuggestions
    zsh-syntax-highlighting   # keep last: it wraps the widgets above
  )

  # Absent on a machine set up offline, or with `setup.sh --config-only`. The
  # shell should still be usable there, so fall back to a plain prompt and say
  # what to run rather than erroring on every startup.
  if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
  else
    ZSH_THEME=""
    PROMPT='%n@%m %~ %# '
    print -u2 "oh-my-zsh is not installed — run: $SRV_DIR/tools/zsh.sh"
  fi
fi


# ---------------------------------------------------------------------------
# Shared environment (also used by bash and by SLURM job scripts)
# ---------------------------------------------------------------------------
# Guarded, like ~/.bashrc: the shell must still start if ~/server has been
# moved or deleted — it just loses $SCRATCH, the caches and the extra PATH.
if [[ -r "$SRV_DIR/shell/env.sh" ]]; then
  source "$SRV_DIR/shell/env.sh"
else
  print -u2 "no $SRV_DIR/shell/env.sh — the bundle has moved; set SRV_DIR in ~/.zshrc.local"
fi


# ---------------------------------------------------------------------------
# Cluster modules
# ---------------------------------------------------------------------------
# The list comes from hosts/<host>.sh and names modules without a version.
# Most sites resolve that to a default; some define none ("No default
# version defined for 'anaconda3'"), so a name that fails to load is retried
# as the newest version `module avail` lists for it. A module that does not
# exist on this machine at all is skipped and recorded, so a shared config
# never errors out on a server that lacks it — run `srvinfo` to see what was
# skipped. An entry may list alternatives, `anaconda3|miniconda3`, for
# profiles that cannot know a site's naming (generic.sh): the first that loads
# wins. Nothing runs where there is no `module` command at all. RC's advice is
# to load modules in job scripts, not shell startup; this is the interactive
# convenience only, and batch jobs never run it.
typeset -ga SRV_MODULES_MISSING=()
_srv_module_load() {
  module load "$1" 2>/dev/null && return 0
  local newest
  # -t is the terse listing; entries arrive on stderr, some tagged (default).
  # Tags differ by implementation: Lmod's (default), Tcl Modules 4/5's
  # (default:stable), (@) or <L>.
  newest="$(module -t avail "$1" 2>&1 | sed -e 's/([^)]*)$//' -e 's/<[^>]*>$//' | grep "^$1/" |
            sort -V 2>/dev/null | tail -n 1)"
  [[ -n "$newest" ]] && module load "$newest" 2>/dev/null
}
# A zsh started by bash's hand-over is not a login shell, and the site's
# login profile is often what defines `module`: load its zsh init if needed.
if [[ -n "$SRV_MODULES" ]] && ! command -v module >/dev/null 2>&1; then
  for _init in "${MODULESHOME:-}/init/zsh" "${LMOD_PKG:-}/init/zsh" /usr/share/Modules/init/zsh /etc/profile.d/modules.sh; do
    [[ -r "$_init" ]] && { source "$_init" 2>/dev/null; break; }
  done
  unset _init
fi
if [[ -n "$SRV_MODULES" ]] && command -v module >/dev/null 2>&1; then
  for _mod in ${=SRV_MODULES}; do
    for _alt in ${(s:|:)_mod}; do
      _srv_module_load "$_alt" && continue 2
    done
    SRV_MODULES_MISSING+=("$_mod")
  done
  unset _mod _alt
fi
unset -f _srv_module_load


# ---------------------------------------------------------------------------
# PATH
# ---------------------------------------------------------------------------
# `typeset -U` keeps $path unique, so nested shells, `exec zsh` and module
# loads cannot accumulate duplicate entries.
typeset -U path PATH fpath


# ---------------------------------------------------------------------------
# Interactive environment
# ---------------------------------------------------------------------------
# Fill in TERM where it is missing or plain, and replace it where this host's
# terminfo has never heard of it: RHEL's database lacks xterm-kitty, wezterm
# and xterm-ghostty, and with one of those tmux refuses to start and less/nvim
# complain about an unknown terminal. Anything terminfo does know — tmux's own
# tmux-256color, a truecolor terminal's advertised name — is left alone, since
# overriding it breaks colours and keys. `dumb` is a deliberate request for
# plain output (Emacs/TRAMP) and is honoured.
case "${TERM:-}" in
  ''|xterm) TERM="xterm-256color" ;;
  dumb)     ;;
  *) if (( $+commands[infocmp] )) && ! infocmp "$TERM" >/dev/null 2>&1; then
       TERM="xterm-256color"
     fi ;;
esac
export TERM
# Defaults only: an editor or pager you chose above the block stays.
if [[ -z "${EDITOR:-}" ]]; then
  if (( $+commands[nvim] )); then export EDITOR=nvim; else export EDITOR=vim; fi
fi
export VISUAL="${VISUAL:-$EDITOR}"
export PAGER="${PAGER:-less}"
export LESS="${LESS:--R}"


# ---------------------------------------------------------------------------
# History and shell options
# ---------------------------------------------------------------------------
# Left to your own setup when there is one, like the prompt.
if (( ! _srv_own_setup )); then
  HISTFILE="$HOME/.zsh_history"
  HISTSIZE=50000
  SAVEHIST=50000

  setopt SHARE_HISTORY          # one history across concurrent sessions
  setopt HIST_IGNORE_ALL_DUPS   # keep only the most recent copy of a command
  setopt HIST_IGNORE_SPACE      # a leading space keeps a command out of history
  setopt HIST_REDUCE_BLANKS
  setopt EXTENDED_HISTORY       # record timestamps and durations

  setopt AUTO_CD                # `foo/` instead of `cd foo/`
  setopt AUTO_PUSHD             # cd maintains a directory stack
  setopt PUSHD_IGNORE_DUPS
  setopt INTERACTIVE_COMMENTS   # allow `# comments` when pasting commands
  setopt NO_BEEP
fi


# ---------------------------------------------------------------------------
# Aliases and functions
# ---------------------------------------------------------------------------
# slurm.zsh is pruned away on machines with no scheduler (setup.sh), so all
# three are guarded rather than sourced blind.
for _f in aliases functions slurm; do
  [[ -r "$SRV_DIR/shell/$_f.zsh" ]] && source "$SRV_DIR/shell/$_f.zsh"
done
unset _f


# ---------------------------------------------------------------------------
# Tool integrations
# ---------------------------------------------------------------------------
# Powerlevel10k user config, unless your own setup already loaded it.
if (( ! _srv_own_setup )) && [[ -r ~/.p10k.zsh ]]; then
  source ~/.p10k.zsh
fi

# fzf: Ctrl-R over history, Ctrl-T over files, Alt-C to cd. Guarded because
# tools/cli.sh may not have run yet, or may have been offline when it did.
if command -v fzf >/dev/null 2>&1; then
  # `fzf --zsh` exists from fzf 0.48; an older system copy would print an
  # error at every start, so its output is only used when it worked.
  if _srv_fzf="$(fzf --zsh 2>/dev/null)"; then eval "$_srv_fzf"; fi
  unset _srv_fzf
  # Respect .gitignore when listing files, and search hidden files too.
  command -v fd >/dev/null 2>&1 && \
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
fi


# ---------------------------------------------------------------------------
# Machine-local overrides (keep last, never synced)
# ---------------------------------------------------------------------------
[[ -r ~/.zshrc.local ]] && source ~/.zshrc.local
