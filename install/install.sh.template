#!/usr/bin/env bash
# install.sh — one command to set this machine up.
#
#   curl -fsSL __URL_BASE__/install.sh | bash
#
# Downloads the bundle, unpacks it into $HOME, and runs setup.sh. Generated by
# make-bundle.sh; upload it next to server.zip.
#
# The one subtlety: piped into bash, this script *is* stdin, so setup.sh would
# have nothing to read its prompts from. It is therefore reconnected to the
# terminal below, which keeps the conda question and the passphrase prompt
# working. Where there is no terminal — CI, a provisioning run — setup.sh
# falls back to its documented defaults instead of hanging.

set -euo pipefail

ZIP_URL="${SERVER_ZIP_URL:-__URL_BASE__/server.zip}"
DEST="$HOME"

say() { printf '  %s\n' "$*"; }
die() { printf '  ! %s\n' "$*" >&2; exit 1; }

# For a new machine only. An existing ~/server holds your own git-ignored
# files (server.json, hosts/*.local.sh, secrets/secrets.enc) that unpacking
# over it would replace; update it with srvsync instead.
if [ -e "$DEST/server" ]; then
    die "$DEST/server already exists — update it with srvsync, or move it aside to reinstall"
fi

printf '\n== Downloading\n'
say "$ZIP_URL"
cd "$DEST"

if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o server.zip "$ZIP_URL" || die "download failed"
elif command -v wget >/dev/null 2>&1; then
    wget -qO server.zip "$ZIP_URL" || die "download failed"
else
    die "neither curl nor wget is installed"
fi

command -v unzip >/dev/null 2>&1 || die "unzip is not installed (sudo apt install unzip)"

printf '\n== Unpacking\n'
unzip -q server.zip || die "the download is not a valid zip"
say "$DEST/server"

[ -x "$DEST/server/setup.sh" ] || die "server/setup.sh missing from the bundle"

# Actually open it. /dev/tty passes -e and -r whenever the device node is
# there, but opening it fails with ENXIO in any process without a controlling
# terminal — a systemd unit, a cloud-init run, `ssh host <cmd>`. Testing the
# open is the only check that tells the truth.
if (exec 3< /dev/tty) 2>/dev/null; then
    exec "$DEST/server/setup.sh" "$@" < /dev/tty
else
    say "no controlling terminal — running non-interactively"
    exec "$DEST/server/setup.sh" "$@" < /dev/null
fi
